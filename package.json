    "ioredis": "^5.6.1",
    "multer": "2.0.2",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.15.21",
    "@types/pg": "^8.15.4",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "7.1.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.3"
  }
