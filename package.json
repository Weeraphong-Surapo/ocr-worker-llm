{
  "name": "thai-ocr-service-api",
  "version": "0.1.0",
  "private": true,
  "description": "Thai OCR REST API",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
